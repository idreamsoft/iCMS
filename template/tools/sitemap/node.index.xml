<!--{'<'|cat:'?xml version="1.0" encoding="UTF-8"?'|cat:'>'}-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc><!--{$site.url}--></loc>
        <lastmod><!--{$iCMS.NOW|date:"Y-m-d"}--></lastmod>
        <changefreq>hourly</changefreq>
        <priority>0.8</priority>
    </url>
    <!--{iCMS:node:list loop="true" row="500" stype='top'}-->
            <loc><!--{$node_list.url|escape}--></loc>
            <lastmod><!--{$iCMS.NOW|date:"Y-m-d"}--></lastmod>
            <changefreq>always</changefreq>
            <priority>0.9</priority>
        </url>
        <!--{foreach value="hl" key="lg" from="$site.devices"}-->
        <url>
            <loc><!--{$node_list.iurl[$lg].url|escape}--></loc>
            <lastmod><!--{$iCMS.NOW|date:"Y-m-d"}--></lastmod>
            <changefreq>always</changefreq>
            <priority>0.9</priority>
        </url>
        <!--{/foreach}-->
        <!--{iCMS:node:list as="sub_node" loop="true" stype='sub' row="500" rootid="$node_list.id"}-->
        <url>
            <loc><!--{$sub_node.url|escape}--></loc>
            <lastmod><!--{$iCMS.NOW|date:"Y-m-d"}--></lastmod>
            <changefreq>always</changefreq>
            <priority>0.8</priority>
        </url>
        <!--{foreach value="hl" key="lg" from="$site.devices"}-->
        <url>
            <loc><!--{$sub_node.iurl[$lg].url|escape}--></loc>
            <lastmod><!--{$iCMS.NOW|date:"Y-m-d"}--></lastmod>
            <changefreq>always</changefreq>
            <priority>0.9</priority>
        </url>
        <!--{/foreach}-->
        <!--{/iCMS}-->

        <!--{iCMS:content:list appid="$node.appid" loop="true" row="500" sub="true" cid="$node_list.id"}-->
        <!--{if $content_list.url}-->
        <url>
            <loc><!--{$content_list.url|escape}--></loc>
            <lastmod><!--{$content_list.pubdate|date:"Y-m-d"}--></lastmod>
            <changefreq>weekly</changefreq>
            <priority>0.8</priority>
        </url>
        <!--{/if}-->
        <!--{/iCMS}-->
    <!--{/iCMS}-->
</urlset>
